# API Configuration
VITE_API_URL=http://localhost:8000/api

# Application
VITE_APP_NAME="Plateforme de Gestion Communautaire"
VITE_APP_DESCRIPTION="Annuaire des compétences locales"

# Cloudinary (si utilisé côté frontend)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ====================
# CONFIGURATION API
# ====================
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=30000
REACT_APP_DEBUG=true
REACT_APP_VERSION=1.0.0

# ====================
# AUTHENTIFICATION
# ====================
REACT_APP_TOKEN_NAME=auth_token
REACT_APP_REFRESH_TOKEN_NAME=auth_refresh_token
REACT_APP_TOKEN_DURATION=7 # jours

# ====================
# ROUTES PROTÉGÉES
# ====================
REACT_APP_ADMIN_ROLE=admin
REACT_APP_USER_ROLE=user